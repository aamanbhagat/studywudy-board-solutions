{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "studywudy-board-solutions",
  "main": "./worker.js",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "vars": {
    "NEXT_INC_CACHE_R2_PREFIX": "incremental-cache-v17"
  },
  "assets": {
    "directory": "./public-snapshot",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/boards",
      "/search*",
      "/maharashtra-board*",
      "/cbse*",
      "/cisce*",
      "/tamil-nadu-board*",
      "/robots.txt",
      "/ads.txt",
      "/sitemap.xml",
      "/sitemaps/*",
      "/about",
      "/about/*",
      "/privacy",
      "/terms",
      "/contact"
    ]
  },
  "triggers": {
    "crons": ["17 2 * * *"]
  },
  "exports": {
    "DOQueueHandler": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studywudy-content",
      "database_id": "33c51af4-a780-41c9-8294-738365dca1de"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "studywudy-media"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "studywudy-media"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "studywudy-board-solutions"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
